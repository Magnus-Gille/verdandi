[Unit]
Description=Verdandi hash-chain checkpoint
After=verdandi.service

[Service]
Type=oneshot
User=magnus
WorkingDirectory=/home/magnus/repos/verdandi
Environment=VERDANDI_DATA_DIR=/home/magnus/.local/share/verdandi
Environment=VERDANDI_ANCHOR_PATH=/home/magnus/.local/share/verdandi/checkpoints/latest.json
ExecStart=/usr/bin/env node /home/magnus/repos/verdandi/dist/index.js checkpoint
TimeoutStartSec=60
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/magnus/.local/share/verdandi
